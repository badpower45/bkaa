# Environment Variables for Paymob Payment Gateway

# ⚠️ IMPORTANT: Do NOT commit this file to git!
# Add .env to your .gitignore file

# Paymob API Configuration
# Get these from: https://paymob.com/dashboard
PAYMOB_API_KEY=your_api_key_here
PAYMOB_INTEGRATION_ID=your_integration_id_here
PAYMOB_IFRAME_ID=your_iframe_id_here
PAYMOB_HMAC_SECRET=your_hmac_secret_here

# Instructions:
# 1. Create account at https://paymob.com
# 2. Go to Dashboard → Settings → API Keys
# 3. Copy your API Key, Integration ID, and HMAC Secret
# 4. For IFRAME ID, go to Settings → Payment Integrations → Card Integration
# 5. Replace the values above with your actual keys
# 6. Restart your backend server

# Example (fake values):
# PAYMOB_API_KEY=ZXlKaGJHY2lPaUpJVXpJMU5pSXNJblI1Y0NJNklrcFhWQ0o5
# PAYMOB_INTEGRATION_ID=123456
# PAYMOB_IFRAME_ID=654321
# PAYMOB_HMAC_SECRET=A1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6
